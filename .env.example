# Configure the final publicly accessible canonical origin in Vercel.
PUBLIC_SITE_URL=https://kheralia.com
# Keep disabled until copy, legal pages, contact and photography are verified.
PUBLIC_SITE_READY=false
# Contact endpoint uses Resend via HTTPS; no emails are sent without these secrets.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Optional bot verification; if filled in, configure matching form token client-side.
TURNSTILE_SECRET_KEY=
