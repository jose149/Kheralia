---
import type { Locale, PageKey } from "../../i18n/routes";
import { t } from "../../i18n/content";
import { pathFor } from "../../i18n/routes";
import Button from "../ui/Button.astro";
import Hero from "./HeroWithValues.astro";
import WaveDivider from "../decor/WaveDivider.astro";
import BotanicalSprig from "../decor/BotanicalSprig.astro";
import PhilosophyIcon from "../ui/PhilosophyIcon.astro";
import "../../styles/organic.scss";
import "../../styles/philosophy-icons.scss";
import Philosophy from "./Philosophy.astro";
import ServiceCards from "./ServiceCards.astro";
import Reviews from "./Reviews.astro";
import QuoteBanner from "./QuoteBanner.astro";
import ContactTeaser from "./ContactTeaser.astro";
import ServiceFeatures from "./ServiceFeatures.astro";
import Team from "./Team.astro";
import ContactForm from "./ContactForm.astro";
interface Props {
  locale: Locale;
  page: PageKey;
  status?: string;
}
const { locale, page, status } = Astro.props;
const c = t(locale);
---

{page != "contact" && <Hero {locale} {page} />}
{
  page === "home" && (
    <>
      <Philosophy {locale} />
      <ServiceCards {locale} />
      <Reviews {locale} />
      <QuoteBanner {locale} />
      <ContactTeaser {locale} variant="home" />
    </>
  )
}
{
  page === "services" && (
    <>
      <ServiceFeatures {locale} />
      <QuoteBanner {locale} />
      <ContactTeaser {locale} variant="services" />
    </>
  )
}
{
  page === "about" && (
    <>
      <section class="section values-principles">
        <WaveDivider edge="top" color="var(--cream)" />
        <BotanicalSprig tone="sage" className="k-botanical--values" />
        <WaveDivider edge="bottom" color="var(--cream)" />
        <div class="container values-principles__layout">
          <div class="values-principles__intro">
            <span class="eyebrow">{c.philosophy.eyebrow}</span>
            <h2>{c.philosophy.title}</h2>
            <p>{c.philosophy.description}</p>
          </div>
          <div class="values-principles__grid">
            {c.philosophy.principles.map((item) => (
              <article class="principle">
                <span class="principle__medallion" aria-hidden="true">
                  <PhilosophyIcon name={item.icon} />
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <Team {locale} />
      <section class="section story">
        <>
          <BotanicalSprig tone="sage" className="k-botanical--story" />
          <div class="container story__grid">
            <>
              <img
                src="/images/interior.webp"
                width="650"
                height="470"
                loading="lazy"
                alt={
                  locale === "es"
                    ? "Interior cálido de un hogar"
                    : "Warm home interior"
                }
              />
              <div>
                <>
                  <span class="eyebrow">
                    {locale === "es" ? "NUESTRA HISTORIA" : "OUR STORY"}
                  </span>
                  <h2>{c.about.storyTitle}</h2>
                  <p>{c.about.story}</p>
                  <Button href={pathFor(locale, "contact")}>
                    {c.action.contact}
                  </Button>
                </>
              </div>
            </>
          </div>
        </>
      </section>
      <>
        <QuoteBanner {locale} />
        <ContactTeaser {locale} variant="about" />
      </>
    </>
  )
}
{
  page === "contact" && (
    <>
      <ContactForm {locale} {status} />
      <div class="container contact-promises">
        {c.contact.promise.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.subtitle}</p>
          </div>
        ))}
      </div>
      <QuoteBanner {locale} bottomFill="#f9f5ed" />
    </>
  )
}
