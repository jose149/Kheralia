---
import type {Locale} from '../../i18n/routes';
import {t} from '../../i18n/content';
import Icon from '../ui/Icon.astro';
interface Props {locale:Locale}
const {locale}=Astro.props;
---
<section class="values" aria-label={locale==='es'?'Nuestra propuesta de valor':'Our values'}>
  <div class="container values__grid">
    {t(locale).values.map((value)=><div class="value"><div class="value__icon"><Icon name={value.icon} size={41}/></div><h2>{value.title}</h2><p>{value.subtitle}</p></div>)}
  </div>
</section>
