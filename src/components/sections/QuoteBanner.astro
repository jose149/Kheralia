---
import type { Locale } from "../../i18n/routes";
import { t } from "../../i18n/content";
import WaveDivider from "../decor/WaveDivider.astro";

interface Props {
  locale: Locale;
  bottomFill?: string;
}

const { locale, bottomFill = "#E7EBE1" } = Astro.props;
---

<section class="quote-banner quote-banner--mockup">
  <WaveDivider edge="bottom" color={bottomFill} height={150} />
  <div class="container">
    <p>“{t(locale).quote}”</p>
    <span class="quote-banner__rule" aria-hidden="true"></span>
  </div>
</section>

<style>
  /* Solo este componente: no modificar main.scss ni la tipografia global. */
  .quote-banner--mockup {
    /* La fotografia se ha preparado a partir del fondo de los mockups aprobados. */
    background-color: #eddcc4;
    background-image: url("/images/landscape-quote-kheralia.webp");
    background-position: center center;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    padding: clamp(3.15rem, 4.1vw, 4.5rem) 1.2rem clamp(3.6rem, 4.6vw, 5rem);
    min-height: clamp(13.5rem, 18vw, 17rem);
    isolation: isolate;
    overflow: hidden;
  }

  /* El degradado previo tapaba el mar, el atardecer y las hojas. */
  .quote-banner--mockup::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      rgb(248 235 214 / 6%) 0%,
      rgb(249 240 224 / 18%) 30%,
      rgb(249 241 227 / 20%) 62%,
      rgb(248 235 214 / 7%) 100%
    );
    pointer-events: none;
  }

  .quote-banner--mockup .container {
    position: relative;
    z-index: 3;
  }

  .quote-banner--mockup p {
    max-width: 850px;
    margin: 0 auto;
    color: var(--navy);
    /* Conserva la tipografia y el tamano que ya tengas en main.scss. */
    line-height: 1.17;
    white-space: pre-line;
    text-shadow: 0 1px 10px rgb(255 247 231 / 18%);
  }

  .quote-banner--mockup .quote-banner__rule {
    display: block;
    width: 50px;
    height: 1.5px;
    background: var(--gold);
    margin: 1.1rem auto 0;
  }

  @media (max-width: 820px) {
    .quote-banner--mockup {
      padding: 3.2rem 1.2rem 4rem;
      min-height: 220px;
    }
  }

  @media (max-width: 610px) {
    .quote-banner--mockup {
      /* En movil se prioriza que el titular no quede sobre las hojas oscuras. */
      background-size: cover;
      background-position: 52% 50%;
      padding: 3.5rem 1rem 4rem;
      min-height: 240px;
    }

    .quote-banner--mockup::before {
      background: rgb(251 242 226 / 32%);
    }

    .quote-banner--mockup p {
      font-size: clamp(1.7rem, 6.3vw, 2.1rem);
      line-height: 1.2;
    }
  }
</style>
