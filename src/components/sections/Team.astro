---
import type { Locale } from "../../i18n/routes";
import { t } from "../../i18n/content";
import Icon from "../ui/Icon.astro";
import BotanicalSprig from "../decor/BotanicalSprig.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);
const team = [
  {
    name: "Ángel Vieco",
    role: locale === "es" ? "Director de campo" : "Field Director",
  },
  // { name: 'Luis Liñán', role: locale === 'es' ? 'Director técnico' : 'Technical Director' },
];
---

<section class="section team-section">
  <BotanicalSprig tone="sage" className="k-botanical--team" />
  <div class="container team-section__grid">
    <div>
      <span class="eyebrow">{c.about.eyebrow}</span>
      <h2>{c.about.teamTitle}</h2>
      <p>{c.about.teamDescription}</p>
    </div>
    {
      team.map((person) => (
        <div class="team-card">
          <div class="team-card__portrait">
            <Icon name="people" size={64} />
          </div>
          <span class="eyebrow">{person.role}</span>
          <h3>{person.name}</h3>
          <p>
            {locale === "es"
              ? "Fotografía y trayectoria pendientes de validación."
              : "Photo and professional background awaiting approval."}
          </p>
        </div>
      ))
    }
  </div>
</section>
