---
import type { Locale } from "../../i18n/routes";
import Icon from "../ui/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === "es";

// Datos de ejemplo heredados de la versión anterior: confirmar antes de publicar.
const methods = [
  {
    icon: "phone" as const,
    label: es ? "Teléfono" : "Phone",
    value: "+34 600 123 456",
    description: es
      ? "Llámenos, estaremos encantados de atenderle."
      : "We’ll be happy to assist you by phone.",
  },
  {
    icon: "mail" as const,
    label: "Email",
    value: "atencion@kheralia.es.es",
    description: es
      ? "Respondemos por correo lo antes posible."
      : "We respond to emails as soon as possible.",
  },
  {
    icon: "clock" as const,
    label: es ? "Horario de atención" : "Opening hours",
    value: es
      ? "Lunes – Viernes · 9:00 – 18:00"
      : "Monday – Friday · 9:00 – 18:00",
    description: es
      ? "Atención telefónica y por email."
      : "Available by phone and email.",
  },
  {
    icon: "pin" as const,
    label: es ? "Ubicación" : "Location",
    value: es ? "Mallorca, Illes Balears" : "Mallorca, Balearic Islands",
    description: es
      ? "Servicio de atención domiciliaria en la isla."
      : "Home support services on the island.",
  },
];
---

<aside class="k-contact-panel" aria-labelledby="k-contact-panel-title">
  <span class="eyebrow">{es ? "CONTACTO DIRECTO" : "DIRECT CONTACT"}</span>
  <h2 id="k-contact-panel-title">
    {
      es
        ? "También puede contactar con nosotros"
        : "You can also contact us directly"
    }
  </h2>

  <div class="k-contact-panel__list">
    {
      methods.map((method) => (
        <div class="k-contact-method">
          <span class="k-contact-method__icon" aria-hidden="true">
            <Icon name={method.icon} size={25} />
          </span>
          <div class="k-contact-method__content">
            <span class="k-contact-method__label">{method.label}</span>
            {method.icon === 'mail' ? (
            <a class="k-contact-method__value" href="mailto:atencion@kheralia.es.es">{method.value}</a>
          ) : (
            <strong class="k-contact-method__value">{method.value}</strong>
          )}
            <span class="k-contact-method__description">
              {method.description}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <div class="k-mallorca-card">
    <div class="k-mallorca-card__top">
      <div class="k-mallorca-card__text">
        <span class="eyebrow"
          >{es ? "NUESTRA ZONA DE SERVICIO" : "OUR SERVICE AREA"}</span
        >
        <h3>{es ? "En toda Mallorca" : "Across Mallorca"}</h3>
        <p>
          {
            es
              ? "Organizamos apoyo domiciliario en distintos municipios de la isla. Consulte la disponibilidad para su centro."
              : "We arrange home support across the island. Please enquire about availability for your organisation."
          }
        </p>
      </div>
      <img
        class="k-mallorca-card__outline"
        src="/images/mallorca-contorno-real.svg"
        width="330"
        height="258"
        alt={es
          ? "Silueta geográfica de Mallorca con Palma señalada"
          : "Geographical outline of Mallorca with Palma marked"}
        loading="lazy"
      />
    </div>
  </div>
</aside>

<style>
  /* Estilos encapsulados: no se modifica main.scss ni la tipografía global. */
  .k-contact-panel {
    min-width: 0;
    padding: clamp(1.7rem, 3.3vw, 3.2rem);
    background: #fffdf8;
    border: 1px solid var(--border, #ded6ca);
    border-radius: 28px;
    box-shadow: 0 12px 30px #1537520a;
  }
  .k-contact-panel > .eyebrow {
    margin-bottom: 0.7rem;
  }
  .k-contact-panel h2 {
    font-size: clamp(2.05rem, 3.15vw, 3.2rem);
    max-width: 14ch;
    margin: 0 0 2.05rem;
    line-height: 1.08;
    font-family: var(--heading, Georgia, serif);
    overflow-wrap: normal;
  }
  .k-contact-panel__list {
    display: grid;
    gap: 1.5rem;
  }
  .k-contact-method {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: center;
    gap: 1.05rem;
    min-width: 0;
  }
  .k-contact-method__icon {
    display: grid;
    place-items: center;
    align-self: center;
    justify-self: center;
    width: 54px;
    height: 54px;
    flex: none;
    line-height: 0;
    border-radius: 50%;
    background: #f7ede2;
    color: #ae8352;
    border: 1px solid #eadbc7;
  }
  .k-contact-method__icon :global(svg) {
    width: 25px;
    height: 25px;
    display: block;
    flex: none;
  }
  .k-contact-method__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    gap: 0.18rem;
  }
  .k-contact-method__label {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy, #153752);
  }
  .k-contact-method__value {
    display: block;
    font-size: clamp(0.99rem, 1.35vw, 1.18rem);
    line-height: 1.32;
    color: var(--navy, #153752);
    overflow-wrap: anywhere;
  }
  .k-contact-method__description {
    color: var(--ink, #465761);
    font-size: 0.78rem;
    line-height: 1.42;
  }
  .k-mallorca-card {
    margin-top: 2.35rem;
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid #dfdfd9;
    background: #eaf1f4;
  }
  .k-mallorca-card__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(105px, 47%);
    align-items: center;
    gap: 0.35rem;
    padding: 1.65rem 1.1rem 1.2rem 1.65rem;
    background: linear-gradient(130deg, #f1f2e9 0%, #dcebf2 100%);
  }
  .k-mallorca-card__text {
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .k-mallorca-card__text .eyebrow {
    margin-bottom: 0.55rem;
    font-size: 0.62rem;
    letter-spacing: 0.13em;
  }
  .k-mallorca-card h3 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.65rem, 2vw, 2.4rem);
    line-height: 1.08;
    font-family: var(--heading, Georgia, serif);
  }
  .k-mallorca-card p {
    font-size: 0.78rem;
    line-height: 1.45;
    color: #465761;
  }
  .k-mallorca-card__outline {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    object-fit: contain;
  }
  .k-mallorca-card__landscape {
    height: 108px;
    overflow: hidden;
  }
  .k-mallorca-card__landscape img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  @media (max-width: 1150px) {
    .k-contact-panel {
      padding: 1.75rem;
    }
    .k-contact-method {
      grid-template-columns: 50px minmax(0, 1fr);
      gap: 0.75rem;
    }
    .k-contact-method__icon {
      width: 48px;
      height: 48px;
    }
    .k-contact-method__icon :global(svg) {
      width: 23px;
      height: 23px;
    }
    .k-mallorca-card__top {
      padding: 1.35rem 0.85rem 1rem 1.25rem;
    }
  }
  @media (max-width: 820px) {
    .k-contact-panel {
      padding: 2rem;
    }
    .k-contact-method {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 1rem;
    }
    .k-contact-method__icon {
      width: 54px;
      height: 54px;
    }
    .k-mallorca-card__top {
      padding: 1.6rem;
    }
  }
  @media (max-width: 450px) {
    .k-contact-panel {
      padding: 1.35rem;
      border-radius: 22px;
    }
    .k-contact-panel h2 {
      font-size: 2.1rem;
      margin-bottom: 1.65rem;
    }
    .k-contact-panel__list {
      gap: 1.2rem;
    }
    .k-contact-method {
      grid-template-columns: 50px minmax(0, 1fr);
      gap: 0.8rem;
    }
    .k-contact-method__icon {
      width: 48px;
      height: 48px;
    }
    .k-contact-method__icon :global(svg) {
      width: 22px;
      height: 22px;
    }
    .k-mallorca-card__top {
      grid-template-columns: minmax(0, 1fr) minmax(96px, 43%);
      padding: 1.25rem 0.65rem 1rem 1rem;
    }
    .k-mallorca-card h3 {
      font-size: 1.55rem;
    }
    .k-mallorca-card p {
      font-size: 0.72rem;
    }
    .k-mallorca-card__landscape {
      height: 94px;
    }
  }
</style>
