---
import type { Locale } from '../../i18n/routes';
import { pathFor } from '../../i18n/routes';
import { t } from '../../i18n/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import BotanicalSprig from '../decor/BotanicalSprig.astro';
interface Props { locale: Locale; variant?: 'home' | 'services' | 'about' }
const { locale, variant = 'home' } = Astro.props;
const c = t(locale);
const copy = c.teasers[variant];
---
<section class:list={['contact-teaser', 'section', `contact-teaser--${variant}`]}>
  <BotanicalSprig tone="sage" className="k-botanical--contact"/>
  <div class="container contact-teaser__grid">
    <div>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2>{copy.title}</h2>
      <p>{copy.description}</p>
      <Button href={pathFor(locale, 'contact')}>{copy.action}</Button>
    </div>
    <div class="contact-teaser__details">
      <div><Icon name="message"/><span>{locale === 'es' ? 'Una primera conversación cercana' : 'An initial conversation'}</span></div>
      <div><Icon name="shield"/><span>{locale === 'es' ? 'Organización y seguimiento del servicio' : 'Organised support and ongoing review'}</span></div>
      <div><Icon name="pin"/><span>Mallorca · Illes Balears</span></div>
    </div>
  </div>
</section>
