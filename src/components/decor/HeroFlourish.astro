---
/**
 * Detalle concreto del hero de los mockups: perfil curvo dorado y hojas marfil.
 * Lo insertamos solamente en el hero, no como decoración genérica de secciones.
 */
interface Props { className?: string }
const { className = '' } = Astro.props;
