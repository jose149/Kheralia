  <path d="M91 300 C93 255 73 225 74 176 C74 144 91 112 91 76" fill="none" stroke="#A6A78C" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M80 259 C64 241 45 219 31 211 M77 192 C103 177 117 152 124 127 M84 141 C67 123 57 105 57 83" fill="none" stroke="#A6A78C" stroke-width="1.25" stroke-linecap="round"/>
