---
import type {Locale,PageKey} from '../../i18n/routes';
import {pathFor} from '../../i18n/routes';
import {t} from '../../i18n/content';
interface Props {locale:Locale}
const {locale}=Astro.props;
const copy=t(locale);
---
<footer class="site-footer">
  <div class="container site-footer__top">
    <div>
      <a class="brand" href={pathFor(locale,'home')} aria-label="Kheralia Mind & Well — home"><img src="/images/logo-icon.png" width="56" height="56" alt=""/><span class="brand__name">Kheralia<small>MIND & WELL</small></span></a>
      <p class="site-footer__intro">{copy.footer.intro}</p>
    </div>
    <nav class="site-footer__nav" aria-label={copy.footer.navLabel}>
      {(Object.keys(copy.nav) as PageKey[]).map((key)=><a href={pathFor(locale,key)}>{copy.nav[key]}</a>)}
    </nav>
    <div class="site-footer__contact"><strong>{copy.nav.contact}</strong><p>Illes Balears · Mallorca</p><a href={pathFor(locale,'contact')}>{copy.action.contact} →</a>
      <p class="site-footer__email"><a href="mailto:info@kheralia.es">info@kheralia.es</a></p>
    </div>
  </div>
  <div class="container site-footer__bottom"><small>© {new Date().getFullYear()} {copy.footer.copyright}</small><div class="site-footer__legal"><a href={`/${locale}/${locale==='es'?'aviso-legal':'legal-notice'}/`}>{copy.footer.legal}</a><a href={`/${locale}/${locale==='es'?'privacidad':'privacy'}/`}>{copy.footer.privacy}</a></div><small>{copy.footer.demo}</small></div>
</footer>
