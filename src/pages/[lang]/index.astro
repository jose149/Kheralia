---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/sections/PageContent.astro';
import type {Locale} from '../../i18n/routes';
export function getStaticPaths(){return (['es','en'] as const).map((lang)=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
---
<BaseLayout locale={lang} page="home"><PageContent locale={lang} page="home"/></BaseLayout>
